{
  "name": "jellyfin-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Jellyfin (stdio + streamable HTTP)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jellyfin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node test/smoke.mjs",
    "test:live": "node test/live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
