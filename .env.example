# --- Jellyfin ---
JELLYFIN_URL=http://localhost:8096
# Either an API key (Dashboard > API Keys) ...
JELLYFIN_API_KEY=
# ... or a username/password login. With an API key, JELLYFIN_USERNAME alone picks which user to act as.
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=
# JELLYFIN_USER_ID=
# JELLYFIN_READ_ONLY=true

# --- HTTP transport (only used with --transport http) ---
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# MCP_HTTP_PATH=/mcp
# MCP_AUTH_TOKEN=change-me
# MCP_ALLOWED_HOSTS=jellyfin-mcp.lan,localhost
# MCP_ALLOWED_ORIGINS=
